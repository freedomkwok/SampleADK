# --- Oracle PG (Graphiti driver; DSN-first) ---
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# Optional default property graph id for Oracle PG driver
GRAPHITI_GRAPH_ID=

# Graphiti partition (group_id) used when the model does not pass group_id
GRAPHITI_DEFAULT_GROUP_ID=

# --- OpenAI API (ChatGPTClient; Graphiti may use these for embeddings/LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
# Google ADK LlmAgent (Gemini) when ADK_USE_LITELLM_CHATGPT is unset/false.
ADK_MODEL=gemini-2.0-flash
# Set to 1 to run the agent LLM via LiteLLM -> ChatGPTClient (OpenAI API).
# ADK_USE_LITELLM_CHATGPT=
# LITELLM_MODE=PRODUCTION

# --- Langfuse (optional) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
