# --- Oracle PG (Graphiti driver) ---
# ORACLE_URI=oracle://user:pass@host:1521/service
# or ORACLE_DSN / ORACLE_USER / ORACLE_PASSWORD
ORACLE_URI=
ORACLE_USER=
ORACLE_PASSWORD=

# Optional default property graph id for Oracle PG driver
GRAPHITI_GRAPH_ID=

# Graphiti partition (group_id) used when the model does not pass group_id
GRAPHITI_DEFAULT_GROUP_ID=

# --- LLM / embeddings (Graphiti defaults use OpenAI-style env names) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
ADK_MODEL=gemini-2.0-flash

# --- Langfuse (optional) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
